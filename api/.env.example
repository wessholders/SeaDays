ENVIRONMENT=local
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

# For Supabase, prefer the connection pooler URL if direct IPv6 DB access fails.
# Keep sslmode=require for Supabase connections.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/seadays
SUPABASE_URL=https://example.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://example.supabase.co/auth/v1
SUPABASE_JWT_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=seadays-local
R2_PUBLIC_BASE_URL=
